    "status": 501,
    "body": {
      "error": "This feature is not built yet.",
      "code": "NOT_IMPLEMENTED"
    }
  },
  "body 超過 1 MB": {
    "request": "POST /cleanup/plans",
    "status": 413,
    "body": {
      "error": "The body is too large (1 MB limit).",
      "code": "BODY_TOO_LARGE"
    }
  },
  "沒帶 token": {
    "request": "GET /cleanup/candidates",
    "status": 401,
    "body": {
      "error": "Wrong token. Paste the contents of ~/.contextbox/token into the extension settings."
    }
  },
  "網頁來的請求": {
    "request": "GET /cleanup/candidates",
    "status": 403,
    "body": {
      "error": "A web page cannot read the fact store directly"
    }
  },
  "另一個清理動作正在跑": {
    "request": "POST /cleanup/plans/:id/undo",
    "status": 503,
    "headers": {
      "retry-after": "2"
