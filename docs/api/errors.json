  "已經套用的計畫再 dismiss": {
    "request": "POST /cleanup/plans/:id/dismiss",
    "status": 409,
    "body": {
      "error": "This plan has started running. Use undo instead.",
      "code": "CONFLICT"
    }
  },
  "已經開始的計畫不能放棄": {
    "request": "POST /cleanup/plans/:id/release",
    "status": 409,
    "body": {
      "error": "This plan has started running, so it cannot be dropped. Use undo to put things back.",
      "code": "CONFLICT"
    }
  },
  "這台機器的設定有問題（例如隔離區不是資料夾）": {
    "request": "POST /cleanup/plans/:id/apply",
    "status": 500,
    "body": {
      "error": "Only ordinary files are handled — not symlinks or hard links.",
      "code": "UNSAFE_PATH"
    }
  },
  "confirmed 不是布林": {
    "request": "POST /cleanup/quarantine/empty",
    "status": 400,
    "body": {
      "error": "confirmed must be true or false.",
      "code": "BAD_BODY"
    }
  },
  "預覽過了但沒帶 confirmed": {
    "request": "POST /cleanup/quarantine/empty",
    "status": 428,
    "body": {
      "error": "Preview first, then confirm emptying quarantine.",
      "code": "CONFIRMATION_REQUIRED"
    }
  },
  "沒先預覽就直接確認": {
    "request": "POST /cleanup/quarantine/empty",
    "status": 428,
    "body": {
      "error": "That confirmation code is not valid. Run the preview again.",
      "code": "CONFIRMATION_REQUIRED"
    }
  },
  "預覽的 token 過期了": {
    "request": "POST /cleanup/quarantine/empty",
    "status": 410,
    "body": {
      "error": "That confirmation code has expired. Run the preview again.",
      "code": "CONFIRMATION_EXPIRED"
    }
  },
  "找不到那份計畫": {
    "request": "GET /cleanup/plans/:id",
    "status": 404,
    "body": {
      "error": "There is no such cleanup plan.",
      "code": "NOT_FOUND"
    }
  },
  "計畫 id 的 %xx 壞掉": {
    "request": "GET /cleanup/plans/%E0%A4%A",
    "status": 400,
    "body": {
      "error": "That plan id is not a valid shape.",
      "code": "BAD_BODY"
    }
  },
  "body 不是 JSON": {
    "request": "POST /cleanup/plans",
    "status": 400,
    "body": {
      "error": "Could not make sense of the body.",
      "code": "BAD_BODY"
    }
  },
  "candidateIds 是 null（沒帶才是預設）": {
    "request": "POST /cleanup/plans",
    "status": 400,
    "body": {
      "error": "Candidate ids must be an array of strings, at most 5000 of them.",
      "code": "BAD_BODY"
    }
  },
  "limit 超出範圍": {
    "request": "GET /cleanup/candidates?limit=0",
    "status": 400,
    "body": {
      "error": "limit must be a whole number between 1 and 1000.",
      "code": "BAD_BODY"
    }
  },
  "清單變了（id 已經不在清單上）": {
    "request": "POST /cleanup/plans",
    "status": 409,
    "body": {
      "error": "The candidates changed. Scan again and build a new plan.",
      "code": "STALE_CANDIDATE"
    }
  },
  "沒有勾任何東西": {
    "request": "POST /cleanup/plans",
    "status": 409,
    "body": {
      "error": "No file was picked for cleanup.",
      "code": "EMPTY_PLAN"
    }
  },
  "用錯方法": {
    "request": "GET /cleanup/scan",
    "status": 405,
    "headers": {
      "allow": "POST"
    },
    "body": {
      "error": "This route only takes POST.",
      "code": "BAD_METHOD"
    }
  },
