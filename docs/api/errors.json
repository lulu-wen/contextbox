  "已經套用的計畫再 dismiss": {
    "request": "POST /cleanup/plans/:id/dismiss",
    "status": 409,
    "body": {
      "error": "計畫已開始執行，請使用復原。",
      "code": "CONFLICT"
    }
  },
  "已經開始的計畫不能放棄": {
    "request": "POST /cleanup/plans/:id/release",
    "status": 409,
    "body": {
      "error": "這份計畫已經開始執行，不能放棄；要還原請用復原。",
      "code": "CONFLICT"
    }
  },
  "這台機器的設定有問題（例如隔離區不是資料夾）": {
    "request": "POST /cleanup/plans/:id/apply",
    "status": 500,
    "body": {
      "error": "只處理一般檔案，不處理捷徑或硬鏈結。",
      "code": "UNSAFE_PATH"
    }
  },
  "confirmed 不是布林": {
    "request": "POST /cleanup/quarantine/empty",
    "status": 400,
    "body": {
      "error": "confirmed 要是 true 或 false。",
      "code": "BAD_BODY"
    }
  },
  "預覽過了但沒帶 confirmed": {
    "request": "POST /cleanup/quarantine/empty",
    "status": 428,
    "body": {
      "error": "請先預覽，再次確認清空隔離區。",
      "code": "CONFIRMATION_REQUIRED"
    }
  },
  "沒先預覽就直接確認": {
    "request": "POST /cleanup/quarantine/empty",
    "status": 428,
    "body": {
      "error": "清空確認無效，請重新預覽。",
      "code": "CONFIRMATION_REQUIRED"
    }
  },
  "預覽的 token 過期了": {
    "request": "POST /cleanup/quarantine/empty",
    "status": 410,
    "body": {
      "error": "清空確認已過期，請重新預覽。",
      "code": "CONFIRMATION_EXPIRED"
    }
  },
  "找不到那份計畫": {
    "request": "GET /cleanup/plans/:id",
    "status": 404,
    "body": {
      "error": "找不到這份清理計畫。",
      "code": "NOT_FOUND"
    }
  },
  "計畫 id 的 %xx 壞掉": {
    "request": "GET /cleanup/plans/%E0%A4%A",
    "status": 400,
    "body": {
      "error": "計畫 id 的格式不正確。",
      "code": "BAD_BODY"
    }
  },
  "body 不是 JSON": {
    "request": "POST /cleanup/plans",
    "status": 400,
    "body": {
      "error": "看不懂送來的資料。",
      "code": "BAD_BODY"
    }
  },
  "candidateIds 是 null（沒帶才是預設）": {
    "request": "POST /cleanup/plans",
    "status": 400,
    "body": {
      "error": "候選 id 必須是字串陣列，最多 5000 筆。",
      "code": "BAD_BODY"
    }
  },
  "limit 超出範圍": {
    "request": "GET /cleanup/candidates?limit=0",
    "status": 400,
    "body": {
      "error": "limit 要是 1 到 1000 之間的整數。",
      "code": "BAD_BODY"
    }
  },
  "清單變了（id 已經不在清單上）": {
    "request": "POST /cleanup/plans",
    "status": 409,
    "body": {
      "error": "候選已變更，請重新掃描並建立計畫。",
      "code": "STALE_CANDIDATE"
    }
  },
  "沒有勾任何東西": {
    "request": "POST /cleanup/plans",
    "status": 409,
    "body": {
      "error": "沒有選擇可清理的檔案。",
      "code": "EMPTY_PLAN"
    }
  },
