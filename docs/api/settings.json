{
  "path": "~/.contextbox/config.json",
  "editable": {
    "readonly": false,
    "model": {
      "baseUrl": "https://api.example.com/v1",
      "name": "example-model",
      "keyEnv": "CONTEXTBOX_MODEL_KEY"
    },
    "cleanup": {
      "screenshots": false
    }
  },
  "keySet": true,
  "shown": {
    "watch": [
      "~/Downloads"
    ],
    "filed": "~/Documents/Filed",
    "cleanupRoots": [
      "~/Downloads"
    ],
    "quarantine": "~/.contextbox/quarantine",
    "pdfPages": 3,
    "maxBytes": 20971520
  },
  "problems": [],
  "live": [
    "readonly",
    "model.baseUrl",
    "model.name",
    "model.keyEnv"
  ],
  "restart": [
    "cleanup.screenshots"
  ]
}
